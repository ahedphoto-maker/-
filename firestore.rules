rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is authenticated with a real email (logged-in team member)
    function isTeamMember() {
      return isAuthenticated() && request.auth.token.email != null;
    }

    // Helper: Check if user is Admin / Supervisor
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.isSupervisor == true ||
        request.auth.uid == 'exGmtjCKN9ZKa3HvmoGxiCZH3O63' || // عاهد العماري (Primary Admin UID)
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email in ['ahdalamary@gmail.com', 'ahed@lensflow.sa', 'admin@lensflow.sa'])
      );
    }

    // Helper: Prevent mock data seeding by blocking small numeric IDs in operational tables
    function isValidId(id) {
      return !id.matches('^[0-9]+$') || int(id) >= 100000;
    }

    // Rules for Bookings collection (special read permission)
    match /bookings/{bookingId} {
      allow get: if isAuthenticated();
      allow list, write: if isTeamMember() && isValidId(bookingId);
    }

    // Rules for Team collection (structural)
    match /team/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isTeamMember();
    }

    // Rules for customRoles collection (structural)
    match /customRoles/{roleId} {
      allow read, write: if isTeamMember();
    }

    // Rules for equipment collection (structural)
    match /equipment/{equipmentId} {
      allow read, write: if isTeamMember();
    }

    // Rules for Devices collection (special access)
    match /devices/{deviceId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == (resource != null ? resource.data.userId : request.resource.data.userId) ||
        isAdmin()
      );
    }

    // Rules for Settings collection (admin only write)
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default fallback for operational collections (clients, projects, invoices, expenses, etc.)
    match /{collectionName}/{docId} {
      allow read, write: if isTeamMember() && isValidId(docId);
    }
  }
}
